    },
    "AI processing can use your clipboard or selected text as additional context for smarter results.": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 处理可将剪贴板或选中文本作为额外上下文，以获得更智能的结果。"
          }
        }
      }
    },
    "AI processing provider": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 处理服务商"
          }
        }
      }
    },
    "AI-powered semantic search across your notes in the search bar, Smart Chat, and the cross-note search tool. When disabled, Smart Search stops indexing your notes and hides those surfaces.": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在搜索栏、智能对话和跨笔记搜索工具中，对笔记进行基于 AI 的语义搜索。关闭后，智能搜索将停止为笔记建立索引，并隐藏这些入口。"
          }
        }
      }
    },
    "AI-powered semantic search across your notes in the search bar, Smart Chat, and the cross-note search tool. When disabled, Smart Search stops indexing your notes, removes the local semantic index, and hides those surfaces.": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在搜索栏、智能对话和跨笔记搜索工具中，对笔记进行基于 AI 的语义搜索。关闭后，智能搜索将停止为笔记建立索引、移除本地语义索引，并隐藏这些入口。"
          }
        }
      }
    },
    "AI-powered semantic search could not find a close match. Try different wording or switch to Keyword.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 语义搜索未找到足够接近的结果。请换个说法，或切换到关键词搜索。"
          }
        }
      }
    },
