            "state": "translated",
            "value": "完整的语音识别端点 URL"
          }
        }
      }
    },
    "The keyboard finds its way back to twelve more apps, including Microsoft 365 Copilot, Google Drive and Standard Notes. Messages now resumes the conversation you were in.": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
