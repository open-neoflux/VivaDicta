    "File names and entries take placeholders like {date}, {time}, {text} and {mode}. Exporting the same note again updates its entry instead of adding a copy.": {
      "extractionState": "stale",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件名和条目支持 {date}、{time}、{text} 和 {mode} 等占位符。再次导出同一笔记时会更新其条目，而不会新增副本。"
          }
        }
      }
    },
    "Files are expected as <base>/<model-name>.zip, for example <base>/openai_whisper-large-v3-v20240930_turbo_632MB.zip": {
      "localizations": {
